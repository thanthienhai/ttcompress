# Copy to .env and fill in what you need -- .env is gitignored, .env.example
# is the only one tracked. run_pipeline.sh auto-loads .env if present (see
# its header); train.py/evaluate.py don't read these directly, only what
# run_pipeline.sh passes them as --flags, so plain `python train.py ...`
# without run_pipeline.sh does NOT pick up this file.

# --- run_pipeline.sh defaults (same as its --flags; a flag always wins) ---
READER_MODEL=Qwen/Qwen3-8B
ENCODER_PATH=
# e6 | synthetic -- see ttcompress/relevance.py. synthetic needs no checkpoint,
# smoke-tests the pipeline only, never a reportable number.
RELEVANCE=e6
DEVICE=cuda
RATIOS=4,8
ARMS=encoder_pcs,h2o,snapkv

# --- run_pipeline_multi_gpu.sh only: how many GPUs to shard train.py's
# lambda sweep / evaluate.py's arm-ratio bench across (cuda:0..cuda:N-1).
# Neither script parallelizes on its own -- run_pipeline.sh always uses one
# GPU (DEVICE above); this is the sharded alternative. Set to your real GPU
# count, e.g. `nvidia-smi -L | wc -l`. 1 behaves like a plain single-GPU run.
NUM_GPUS=1

# --- Hugging Face ---
# Needed for gated/private reader models, and REQUIRED (with write access) to
# push results (--push-to-hub / PUSH_TO_HUB=1) -- the three data sources here
# are public and don't need it just to read.
HF_TOKEN=
# Redirect the model/dataset cache off the system drive if it's small.
HF_HOME=
# Silences the "process forked" tokenizer warning under multiprocessing.
TOKENIZERS_PARALLELISM=false

# --- Push run results to HF (opt-in: --push-to-hub, or PUSH_TO_HUB=1 here) ---
# Only results/*.json (lambda curve, dev/test split, official bench CI) are
# ever pushed -- PCS trains no model, so there's no model repo (see
# scripts/push_results.py). Dataset repo id, e.g. you/ttcompress-pcs-results.
PUSH_TO_HUB=0
HF_REPO_ID=
# 1 = private (default), 0 = public
HF_PRIVATE=1

# --- GPU selection ---
# Restrict which GPU(s) are visible, e.g. "0" or "0,1".
CUDA_VISIBLE_DEVICES=
