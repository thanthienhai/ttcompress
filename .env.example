HF_TOKEN=

NUM_GPUS=4
RUN_ROOT=/mnt/hps/anhm-paper/ttcompress/runs/main
# Stage A records are keyed by document and reused by any later run with the SAME settings. The UIT split v2,
# the 64-token single-hop answer budget and the SEA-LION prompt fix changed them: measure refuses the old
# runs/labels (pilot / smoke), so use a fresh dir. A smoke run into it measures for real and the full run
# reuses those first documents.
LABELS=/mnt/hps/anhm-paper/ttcompress/runs/labels_v2

N_TRAIN=3000
N_DEV=300
N_TEST=500

# upload is left out on purpose: run it afterwards from a CPU pod (STAGES=upload bash run_pipeline.sh)
STAGES="preflight prefetch labels fit ensemble train select answer report"
BACKEND=vllm

LABEL_READERS="Qwen/Qwen3-8B Qwen/Qwen3-1.7B aisingapore/Llama-SEA-LION-v3-8B"
EVAL_READERS="Qwen/Qwen3-8B Qwen/Qwen3-1.7B aisingapore/Llama-SEA-LION-v3-8B Qwen/Qwen3-32B"
TP_LARGE=2
MAX_MODEL_LEN=16384
GPU_MEM=0.90
DOCS_PER_CALL=16

TRAIN_SOURCES="uit_viquad vimqa hotpotqa"
EVAL_SOURCES="uit_viquad,xquad_vi,vimqa,hotpotqa,2wiki"
RATIOS="4,8"
# oracle_beta upper bound (H1): Stage A labels of the first ORACLE_N test docs per eval source, primary reader (0 = off)
ORACLE_N=100
# confirmatory tests in the report (METHOD_SPEC.md section 1): H2b equivalence margin, H1 non-inferiority margin
# to oracle_beta, minimum full-context weak->strong F1 gap for an upgrade-retention ratio (H3)
EQUIV_MARGIN=0.02
ORACLE_MARGIN=0.05
MIN_UPGRADE_GAP=0.05

BACKBONE=BAAI/bge-reranker-v2-m3
EMBED_MODEL=BAAI/bge-m3
# published compressors as budget-matched arms (ttcompress/selection.py); their packages are installed at
# preflight: spacy/nltk (provence), peft (exit), llmlingua (llmlingua2), and transformers 4.46.3 + llmlingua into
# LLMLINGUA_SITE for llmlingua/longllmlingua. `exit` needs google/gemma-2b-it: accept the Gemma license on
# huggingface.co with the HF_TOKEN account. Labels must stay as written: the H1 family looks them up.
EXTRA_ARMS="provence=provence:naver/provence-reranker-debertav3-v1,xprovence=provence:naver/xprovence-reranker-bgem3-v1,recomp,exit,llmlingua,longllmlingua,llmlingua2"

# --outcomes is set by run_pipeline.sh (log-prob only for the primary reader's train/dev labels)
MEASURE_ARGS="--dtype bfloat16 --keep-rates 0.5,0.25 --k-min 64 --k-per-chunk 1.0 --k-max 256 --haystack-chars 30000 --distractors random --multihop-pad-chars 0"
TRAIN_ARGS="--max-len 4096 --epochs 3 --lr 2e-5 --head-lr 1e-3 --warmup 0.06 --weight-decay 0.01 --docs-per-step 8 --tau 1.0 --w-mse 0.5 --grad-clip 1.0 --seed 0"
# training-seed robustness: ours_beta / ours_ens also trained with these seeds ("none" = off)
EXTRA_SEEDS="1 2"
SELECT_ARGS="--haystack-chars 30000 --distractors random --multihop-pad-chars 0"
ANSWER_ARGS="--dtype bfloat16 --chunk 512"

HF_HOME=/mnt/hps/anhm-paper/hf_cache
HF_HUB_DOWNLOAD_TIMEOUT=60
HF_HUB_DISABLE_TELEMETRY=1
HF_NAMESPACE=
HF_REPO_PREFIX=ttcompress
HF_RUN_NAME=main
HF_PRIVATE=true
HF_UPLOAD_LABELS=true

PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
